<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/corner_card" />
            <gradient
                android:angle="315"
                android:endColor="@color/card_back_end"
                android:startColor="@color/card_back_start" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
    <item
        android:width="26dp"
        android:height="26dp"
        android:drawable="@drawable/ic_card_back"
        android:gravity="center" />
</layer-list>
