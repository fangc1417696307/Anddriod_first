<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_table"
    android:orientation="vertical">

    <!-- 计分面板 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_normal"
        app:cardBackgroundColor="@color/felt_card"
        app:cardCornerRadius="@dimen/corner_large"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_score"
                    android:textColor="@color/on_felt_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_felt"
                    android:textSize="@dimen/text_score"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPairs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/on_felt_secondary"
                    android:textSize="@dimen/text_secondary" />

                <TextView
                    android:id="@+id/tvBest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_tiny"
                    android:textColor="@color/on_felt"
                    android:textSize="@dimen/text_label" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 牌桌：由 CardGameView（自定义 ViewGroup）动态生成 16 张牌 -->
    <cn.edu.sicnu.cardgame.view.CardGameView
        android:id="@+id/cardGameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="@dimen/spacing_small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingStart="@dimen/spacing_normal"
        android:paddingTop="@dimen/spacing_small"
        android:paddingEnd="@dimen/spacing_normal"
        android:paddingBottom="@dimen/spacing_normal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRestart"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="@string/action_restart"
            android:textColor="@color/brand_primary"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/corner_card" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExit"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/action_exit"
            android:textColor="@color/white"
            app:cornerRadius="@dimen/corner_card"
            app:strokeColor="@color/white" />
    </LinearLayout>
</LinearLayout>
